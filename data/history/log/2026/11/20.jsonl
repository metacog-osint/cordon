ORDINATION FACILITY. THE ALBUQUERQUE /ZAB/ ARTCC, TEL 505-856-4500, IS THE CDN FAC. 2611210600-2611221300","area_km2":343.0,"ceiling_ft":17999,"floor_ft":9000,"hours":31.0,"impact":"moderate","impact_basis":["343 km2"],"nearest_core30":{"airport":"PHX","km":243.6}},"subject_id":"cordon:tfr:6-9128","event_start":"2026-11-21T06:00:00Z","event_end":"2026-11-22T13:00:00Z","last_change":"new","last_change_at":"2026-11-20T04:03:54Z","subdivisions":["US-AZ"],"valid_until":"2026-11-22T13:00:00Z","baseline_ref":{"id":"faa-tfrs-in-force","type":"rolling","version":"2","window":"the TFRs the FAA listed 72 hours earlier, and those Cordon held in the 14 days before (re-issues)"},"place_basis":"location","sea_areas":[]}}}
